# Copy to .env and adjust. Used for local development and for one-off commands
# (seeding, migrations) against a hosted database.

# Local MySQL:
DATABASE_URL=mysql+pymysql://stockwise:stockwise@127.0.0.1:3306/stockwise
# Aiven (paste the Service URI exactly as shown; ssl-mode=REQUIRED turns on TLS):
# DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Aiven CA certificate, either as a file path or as the PEM text itself:
# DATABASE_SSL_CA=ca.pem
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
BUSINESS_TIMEZONE=Africa/Nairobi

# Optional: creates this admin on first start if the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Set by the Docker image; you normally leave these alone.
# ENVIRONMENT=production        # refuses to start with a weak JWT_SECRET
# STATIC_DIR=/app/static        # serve the built React app from the API
# MIGRATE_ON_STARTUP=false      # the image migrates once before starting workers
