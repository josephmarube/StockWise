# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Local MySQL (use the password you chose when creating the stockwise user):
DATABASE_URL=mysql+pymysql://stockwise:<your-db-password>@127.0.0.1:3306/stockwise

# Aiven: paste the Service URI exactly as shown (ssl-mode=REQUIRED turns on TLS),
# and point DATABASE_SSL_CA at the downloaded CA certificate (or paste its text into DATABASE_CA_CERT).
# DATABASE_URL=mysql://avnadmin:<password>@<service>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
# DATABASE_SSL_CA=ca.pem

# Signing key for login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random key is used each run (you are logged out on restart).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
BUSINESS_TIMEZONE=Africa/Nairobi

# Demo data (python -m scripts.seed): admins get Admin@12345, staff Staff@12345.
# Set this to give every demo account this password instead (use it for a public deployment).
SEED_PASSWORD=

# Optional: create this business and admin on first start if there are no users.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_BUSINESS_NAME=

# Set by the Docker image; you normally leave these alone.
# ENVIRONMENT=production        # refuses to start without a strong JWT_SECRET
# STATIC_DIR=/app/static        # serve the built React app from the API
# MIGRATE_ON_STARTUP=false      # the image migrates once before starting workers
